{
  "name": "gh-code-reviewer",
  "version": "0.1.0",
  "description": "Multi-stage LLM code review for GitHub pull requests: triage, review, critic, summary.",
  "author": "Santhosh Rubenraj",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ghr": "src/cli.ts"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/cli.ts --compile --outfile ghr"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.44",
    "@ai-sdk/google": "4.0.55",
    "@mastra/core": "1.63.0",
    "ai": "7.0.83",
    "ink": "7.1.1",
    "ink-select-input": "6.2.0",
    "ink-spinner": "5.0.0",
    "ink-text-input": "6.0.0",
    "js-tiktoken": "1.0.21",
    "lmdb": "3.5.6",
    "meow": "14.1.0",
    "react": "19.2.8",
    "tar": "7.5.22",
    "tree-sitter": "0.25.1",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-typescript": "0.23.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "19.2.18",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.9"
  }
}
